{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "trip-together",
  "main": "../worker/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "secrets": {
    "required": [
      "SESSION_SIGNING_KEY",
      "GEOAPIFY_API_KEY",
      "AMAP_API_KEY"
    ]
  },
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trip-together",
      "database_id": "local-trip-together",
      "migrations_dir": "schema"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "trip-together-private"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "production",
    "EMAIL_FROM": "",
    "ANALYTICS_ENABLED": "false",
    "ANALYTICS_HOSTNAME": "",
    "OPENPANEL_ORIGIN": "https://api.openpanel.dev",
    "OPENPANEL_CLIENT_ID": ""
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
